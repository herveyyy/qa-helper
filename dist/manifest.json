{
  "name": "Faye",
  "description": "Floating Faye assistant with a right sidebar on any page.",
  "version": "1.6.0",
  "manifest_version": 3,
  "icons": {
    "16": "assets/faye-icon-16.png",
    "48": "assets/faye-icon-48.png",
    "128": "assets/faye-icon-128.png"
  },
  "action": {
    "default_title": "Faye",
    "default_icon": {
      "16": "assets/faye-icon-16.png",
      "48": "assets/faye-icon-48.png",
      "128": "assets/faye-icon-128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "permissions": [
    "storage",
    "cookies",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://erp.livro.systems/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/faye-icon.svg",
        "assets/faye-icon-16.png",
        "assets/faye-icon-48.png",
        "assets/faye-icon-128.png",
        "content/widget.css"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/widget.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
